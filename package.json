{
  "name": "primer",
  "version": "0.1.0",
  "private": true,
  "description": "An AI tutor that maintains an explicit learner model and uses it to choose teaching interventions.",
  "scripts": {
    "dev": "next dev --port 43147 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --port 43147 --hostname 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "eval": "vitest run evals",
    "verify": "pnpm typecheck && pnpm test && pnpm eval"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "unrs-resolver"]
  }
}
