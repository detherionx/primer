# Local development works with no secrets. Fill these only when using Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never put the service-role key in NEXT_PUBLIC_*. Keep it server-only if used.
SUPABASE_SERVICE_ROLE_KEY=

# Model provider is behind a thin interface. Phases 0–2 use the stub renderer.
# Do not couple Primer Core to one vendor.
PRIMER_MODEL_PROVIDER=stub
PRIMER_MODEL_API_KEY=

# Persistence: "local" writes to .data/ (gitignored). "memory" for tests.
PRIMER_STORE=local
